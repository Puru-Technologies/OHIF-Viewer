{
  "name": "@ohif/extension-puru-reports",
  "version": "0.0.1",
  "description": "Puru radiology reports panel + compact series list for puru-quick / puru-report modes",
  "author": "Puru Labs",
  "license": "MIT",
  "main": "dist/ohif-extension-puru-reports.umd.js",
  "module": "src/index.tsx",
  "engines": {
    "node": ">=14",
    "npm": ">=6",
    "yarn": ">=1.18.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ohif-extension"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "clean:deep": "yarn run clean && shx rm -rf node_modules",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "start": "yarn run dev"
  },
  "peerDependencies": {
    "@ohif/core": "3.12.0",
    "@ohif/extension-default": "3.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@babel/runtime": "7.28.2"
  }
}
